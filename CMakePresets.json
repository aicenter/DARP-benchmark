{
  "version": 3,
  "configurePresets": [
    {
      "name": "debug-config",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release-config",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug-config",
      "configuration": "Debug"
    },
    {
      "name": "release",
      "configurePreset": "release-config",
      "configuration": "RelWithDebInfo"
    }
  ]
}