{
  "version": 4,
  "configurePresets": [
    {
      "name": "config-local",
      "toolchainFile": "C:/vcpkg/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl.exe",
        "CMAKE_CXX_COMPILER": "cl.exe"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "debug-config-local",
      "inherits": [
        "debug-config",
        "config-local"
      ]
    },
    {
      "name": "release-config-local",
      "inherits": [
        "release-config",
        "config-local"
      ]
    },
    {
      "name": "release-debug-config-local",
      "inherits": [
        "release-debug-config",
        "config-local"
      ]
    },
    {
      "name": "config-sandbox",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "binaryDir": "$env{HOME}/build/${sourceDirName}/${presetName}"
    },
    {
      "name": "debug-config-sandbox",
      "inherits": [
        "debug-config",
        "config-sandbox"
      ]
    },
    {
      "name": "release-config-sandbox",
      "inherits": [
        "release-config",
        "config-sandbox"
      ]
    },
    {
      "name": "release-debug-config-sandbox",
      "inherits": [
        "release-debug-config",
        "config-sandbox"
      ]
    }
  ],
  "buildPresets": [
    {
      "name": "debug-local",
      "configurePreset": "debug-config-local",
      "configuration": "Debug"
    },
    {
      "name": "release-local",
      "configurePreset": "release-config-local",
      "configuration": "Release"
    },
    {
      "name": "release-debug-local",
      "configurePreset": "release-debug-config-local",
      "configuration": "Release"
    },
    {
      "name": "debug-sandbox",
      "configurePreset": "debug-config-sandbox",
      "configuration": "Debug"
    },
    {
      "name": "release-sandbox",
      "configurePreset": "release-config-sandbox",
      "configuration": "Release"
    },
    {
      "name": "release-debug-sandbox",
      "configurePreset": "release-debug-config-sandbox",
      "configuration": "RelWithDebInfo"
    }
  ],
  "testPresets": [
    {
      "name": "debug-sandbox",
      "configurePreset": "debug-config-sandbox",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release-sandbox",
      "configurePreset": "release-config-sandbox",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
