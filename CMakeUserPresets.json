{
    "version": 4,
    "configurePresets": [
      {
        "name": "config-local",
        "toolchainFile": "C:/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "cacheVariables": {
          "CMAKE_C_COMPILER": "cl.exe",
          "CMAKE_CXX_COMPILER": "cl.exe"
          
        }
      },
      {
        "name": "debug-config-local",
        "inherits": ["debug-config", "config-local"]
      },
      {
        "name": "release-config-local",
        "inherits": [ "release-config", "config-local" ]
      },
      {
        "name": "release-debug-config-local",
        "inherits": [ "release-debug-config", "config-local" ]
      }
    ],
    "buildPresets": [
      {
        "name": "debug-local",
        "configurePreset": "debug-config-local",
        "configuration": "Debug"
      },
      {
        "name": "release-local",
        "configurePreset": "release-config-local",
        "configuration": "Release"
      },
      {
        "name": "release-debug-local",
        "configurePreset": "release-debug-config-local",
        "configuration": "Release"
      }
    ]
}