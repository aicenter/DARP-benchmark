{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "http://example.com/schemas/location",
	"type": "object",
	"properties": {
		"index": {"type": "number"},
		"coordinate": {
			"type": "object",
			"properties": {
				"x": {"type": "number"},
				"y": {"type": "number"}
			},
			"required": ["x", "y"]
		},
		"anyOf": [
			{"required": ["index"]},
			{"required": ["coordinate"]}
		]
	}
}